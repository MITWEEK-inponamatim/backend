SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Optional: direct Postgres (session/direct connection string). When set, the API uses pgx
# with the simple query protocol instead of PostgREST; when empty, PostgREST is used.
DATABASE_URL=
# Required only when project still signs JWTs with HS256.
SUPABASE_JWT_SECRET=
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
TURNSTILE_EXPECTED_HOSTNAME=localhost
SERVICE_API_KEY=replace-with-the-same-random-value-in-analysis-service
PRE_COOKIE_SECRET=replace-with-a-long-random-value
ALLOWED_ORIGINS=http://localhost:3000
IDLE_TIMEOUT_SECONDS=3600
ABSOLUTE_SESSION_SECONDS=86400
MAX_UPLOAD_MB=50
# A community phone report is refused when its proof image is larger than this (MB).
# The analysis service applies the same 5 MB ceiling to the decoded bytes.
MAX_EVIDENCE_MB=5
FILE_RETENTION_DAYS=7
SCAN_POLL_INTERVAL_SECONDS=2
SCAN_TIMEOUT_SECONDS=120
# APK static analysis gets a longer budget than the text scanners.
SCAN_APPLICATION_TIMEOUT_SECONDS=180
# Scan-creation quotas per logged-in user. Set any value to 0 to disable that bucket.
# APK scans draw from FILE_SCAN_LIMIT_PER_HOUR instead of SCAN_LIMIT_PER_HOUR, because each
# file scan occupies the extraction worker and can trigger paid third-party lookups.
SCAN_LIMIT_PER_MINUTE=6
SCAN_LIMIT_PER_HOUR=40
FILE_SCAN_LIMIT_PER_HOUR=12
# Reports and community posts per logged-in user. Duplicate-proofing is the database's job;
# these buckets only stop one account from filling the board.
PHONE_REPORT_HOURLY_LIMIT=10
COMMUNITY_POST_HOURLY_LIMIT=6
COMMENT_MINUTE_LIMIT=5
COMMENT_HOURLY_LIMIT=20
VOTE_LIMIT_PER_MINUTE=30
# Comments read for one post page. One level of replies only, so a flat page is enough.
COMMENT_PAGE_SIZE=200
