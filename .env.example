SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Optional: direct Postgres (session/direct connection string). When set, the API uses pgx
# with the simple query protocol instead of PostgREST; when empty, PostgREST is used.
DATABASE_URL=
# Required only when project still signs JWTs with HS256.
SUPABASE_JWT_SECRET=
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
TURNSTILE_EXPECTED_HOSTNAME=localhost
SERVICE_API_KEY=replace-with-the-same-random-value-in-analysis-service
PRE_COOKIE_SECRET=replace-with-a-long-random-value
ALLOWED_ORIGINS=http://localhost:3000
IDLE_TIMEOUT_SECONDS=3600
ABSOLUTE_SESSION_SECONDS=86400
MAX_UPLOAD_MB=50
MAX_IMAGE_MB=15
FILE_RETENTION_DAYS=7
SCAN_POLL_INTERVAL_SECONDS=2
SCAN_TIMEOUT_SECONDS=120
# APK static analysis gets a longer budget than the text scanners.
SCAN_APPLICATION_TIMEOUT_SECONDS=180
